STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_TOKEN=long-random-string

# Contact form (Resend). Without these the form tells visitors to email you.
RESEND_API_KEY=re_...
CONTACT_FROM="Portfolio <hello@your-verified-domain.com>"
CONTACT_TO=you@example.com

# Chat assistant. Optional: without a key it answers from your site data with simple matching.
# Put these in .env.local and restart `npm run dev`. Check http://localhost:3000/api/assistant to see which mode is active.
# Any OpenAI-compatible chat completions endpoint works.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
