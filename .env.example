STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional analytics and search verification
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Admin-only invoice endpoint
ADMIN_TOKEN=long-random-string

# Contact form
RESEND_API_KEY=re_...
CONTACT_FROM="Portfolio <hello@your-verified-domain.com>"
CONTACT_TO=you@example.com

# Chat assistant. Without a key, the assistant uses local matching.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# LiveKit voice assistant. Use the same project credentials as voice-agent/.env.local.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
